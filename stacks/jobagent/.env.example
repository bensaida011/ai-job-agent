# =====================================================================
#  AI Job Agent - secrets and settings
#  1. Copy this file:   cp .env.example .env
#  2. Protect it:       chmod 600 .env
#  3. Replace every YOUR_... value. Do not use quotes or spaces around "=".
#  4. Apply changes:    docker compose up -d --force-recreate
#  NEVER share, screenshot, upload or commit the real .env file.
# =====================================================================

# --- Job sources --------------------------------------------------------
# Reed: https://www.reed.co.uk/developers/jobseeker  (free key by email)
REED_API_KEY=YOUR_REED_API_KEY

# Adzuna: https://developer.adzuna.com  (optional; leave as-is to skip)
# APP_ID is the SHORT id (8 characters); APP_KEY is the long key.
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY

# Jooble (aggregates Polish boards incl. pracuj.pl): request a free key at
# https://jooble.org/api (one short form, key arrives by email).
JOOBLE_API_KEY=YOUR_JOOBLE_API_KEY

# Apify -> JustJoin.it (Poland's biggest IT board, listings in English).
# Create an account at https://console.apify.com and copy the token from
# Settings -> API & Integrations. Billed per job (~$0.001 each), capped by
# justjoin_max_results in config.json.
APIFY_API_TOKEN=YOUR_APIFY_TOKEN
# JUSTJOIN_ACTOR_ID=unfenced-group~justjoin-scraper

# --- Telegram -------------------------------------------------------------
# Token from @BotFather; chat ID from tools/get_chat_id.py
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# --- NocoDB tracker -------------------------------------------------------
# "nocodb" is the container name on the shared Docker network: keep it.
NOCODB_URL=http://nocodb:8080
NOCODB_TOKEN=YOUR_NOCODB_API_TOKEN
NOCODB_TABLE_ID=YOUR_NOCODB_TABLE_ID

# --- AI provider: Ollama (local) OR Mistral (API) ----------------------------
# Default is ollama. To use the Mistral API instead:
#   1. Get a key at https://console.mistral.ai (La Plateforme)
#   2. Set AI_PROVIDER=mistral, MISTRAL_API_KEY=... and SCORING_MODEL=mistral-small-latest
# Ollama and Mistral expect DIFFERENT model names, so SCORING_MODEL must match
# whichever provider you switched on:
#   ollama  examples: qwen2.5:3b, llama3.1:8b
#   mistral examples: mistral-small-latest, open-mistral-nemo
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama):
# Keep http://ollama:11434 if Ollama runs in the AI stack on this server.
# To use Ollama on another, stronger computer: http://YOUR_OTHER_PC_IP:11434
OLLAMA_URL=http://ollama:11434
SCORING_MODEL=qwen2.5:3b

# Mistral (used when AI_PROVIDER=mistral):
# Get your API key at https://console.mistral.ai  (never share or commit it)
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
# MISTRAL_BASE_URL=https://api.mistral.ai

# --- Time zone (run_times in config.json use this clock) -------------------
TZ=Europe/London
